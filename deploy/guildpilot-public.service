[Unit]
Description=GuildPilot Discord Bot (public)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=guildpilot
Group=guildpilot
WorkingDirectory=/opt/guildpilot-public
ExecStart=/opt/guildpilot-public/venv/bin/python -m modules.bot.main --flavor public
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
