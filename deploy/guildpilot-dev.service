[Unit]
Description=GuildPilot Discord Bot (dev)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=guildpilot
Group=guildpilot
WorkingDirectory=/opt/guildpilot-dev
ExecStart=/opt/guildpilot-dev/venv/bin/python -m modules.bot.main --flavor dev
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
